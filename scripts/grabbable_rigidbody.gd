extends RigidBody3D
## Общая отметка для физических объектов, которые можно поднимать мышью.

func _ready() -> void:
	# Группа назначается в runtime на самом корневом RigidBody3D.
	# Это надёжнее, чем рассчитывать только на запись groups в текстовой сцене:
	# PhysicsGrab проверяет группу именно у тела, которое вернул луч.
	add_to_group("grabbable")
